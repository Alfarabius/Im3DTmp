    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "LMB - throw / hold - use\nRMB - drop\n1,2,3 - take"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "RT - throw / hold - use\nLT - drop\nD-pad: Left/Up/Right - take"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "Hold A to skip"
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "Our little Gingerbread town was getting ready for its annual celebration"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "Suddenly, Mr. Gingerbread went berserk and grabbed a shotgun"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "I remembered a phone in one of the presents. I had to find it and call the police"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "The police arrived very quickly"
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "Mr. Gingerbread refused to drop the shotgun. The reasons for his behavior remain unknown"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "Many were hurt that day. The event left a lasting scar on our town"
    m_Metadata:
      m_Items: []
